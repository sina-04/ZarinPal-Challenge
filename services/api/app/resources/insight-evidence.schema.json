{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/zarinpal-insight-evidence.schema.json",
  "title": "ZarinPal Insight Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "insight_id", "metric_id", "title", "statement",
    "insight_type", "value", "unit", "grain", "population", "formula",
    "source_columns", "filters", "exclusions", "null_policy", "date_range",
    "timezone", "sample_size", "comparison", "calculation_inputs", "weighting",
    "minimum_sample_rule", "calculation_version", "reproduction",
    "limitations", "generated_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "insight_id": {"type": "string", "minLength": 1},
    "metric_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "title": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "insight_type": {"enum": ["descriptive", "diagnostic", "inferential", "predictive", "recommendation", "alert"]},
    "value": {"type": ["number", "integer", "string", "null"]},
    "unit": {"type": "string", "minLength": 1},
    "grain": {"enum": ["attempt", "session", "customer_within_merchant", "terminal", "merchant", "category", "time_period"]},
    "population": {"type": "string", "minLength": 1},
    "formula": {"type": "string", "minLength": 1},
    "source_columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merchant_key", "created_at_from", "created_at_to", "metric_rules"],
      "properties": {
        "merchant_key": {"type": "string"},
        "created_at_from": {"type": "string"},
        "created_at_to": {"type": "string"},
        "metric_rules": {"type": "array", "items": {"type": "string"}}
      }
    },
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "null_policy": {"type": "string", "minLength": 1},
    "date_range": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {"start": {"type": "string"}, "end": {"type": "string"}}
    },
    "timezone": {"type": "string", "minLength": 1},
    "sample_size": {"type": "integer", "minimum": 0},
    "comparison": {
      "type": "object", "additionalProperties": true, "required": ["type"],
      "properties": {
        "type": {"enum": ["none", "previous_period", "previous_year", "peer_group", "target", "baseline"]},
        "value": {"type": ["number", "integer", "string", "null"]},
        "absolute_difference": {"type": ["number", "integer", "null"]},
        "relative_difference": {"type": ["number", "integer", "null"]},
        "definition": {"type": "string"},
        "weighting": {"type": "string"}
      }
    },
    "calculation_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator_definition", "numerator_value", "denominator_definition", "denominator_value"],
      "properties": {
        "numerator_definition": {"type": ["string", "null"]},
        "numerator_value": {"type": ["number", "integer", "null"]},
        "denominator_definition": {"type": ["string", "null"]},
        "denominator_value": {"type": ["number", "integer", "null"]}
      }
    },
    "weighting": {"type": "string", "minLength": 1},
    "minimum_sample_rule": {"type": "string", "minLength": 1},
    "calculation_version": {"type": "string", "minLength": 1},
    "reproduction": {
      "type": "object", "additionalProperties": true,
      "required": ["method", "reference", "parameters_hash"],
      "properties": {
        "method": {"enum": ["query_registry", "materialized_aggregate", "analytical_function"]},
        "reference": {"type": "string", "minLength": 1},
        "parameters_hash": {"type": "string", "minLength": 1},
        "git_revision": {"type": "string"}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "recommendation": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "trigger", "expected_mechanism", "priority", "confidence", "measurement_plan"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "expected_mechanism": {"type": "string", "minLength": 1},
        "priority": {"enum": ["low", "medium", "high"]},
        "confidence": {"enum": ["exploratory", "supported", "strong"]},
        "measurement_plan": {"type": "string", "minLength": 1}
      }
    },
    "model_evidence": {"type": "object"},
    "generated_at": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"insight_type": {"const": "recommendation"}}}, "then": {"required": ["recommendation"]}},
    {"if": {"properties": {"insight_type": {"const": "predictive"}}}, "then": {"required": ["model_evidence"]}}
  ]
}
