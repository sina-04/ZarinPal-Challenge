# Shared internal boundary. Use one strong value for both services in production.
INTERNAL_API_KEY=local-development-only-change-me
TZ=Asia/Tehran

# Web -> API. API_BASE_URL is for local/deployed absolute URLs. Render injects
# API_HOSTPORT from its private network and the web service adds http:// itself.
API_BASE_URL=http://127.0.0.1:8000
API_HOSTPORT=

# Optional grounded analyst. Keep this server-side; never prefix it NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Pinned official challenge input (61,282,974 bytes, validated without errors or
# session conflicts). Keep DATASET_PATH blank for the full URL-backed dataset.
DATASET_URL=https://startech.s3.ir-thr-at1.arvanstorage.ir/other%2Fchallenge_data.csv.gz?versionId=
DATASET_SHA256=84ac8a28df48ca7baeaf0b1cec563a3f0a3516039f5f62e9bfd11124ca35b461

# A nonblank local .csv, .csv.gz, .xlsx, or cleaned-markdown path takes
# precedence. For challenge_data_cleaned.xlsx, also replace DATASET_SHA256 with
# 34b265c9d9c9fd865a838ed017fd7d62625f6d41ae23bfe7cca59e6a36d82693;
# that Excel-ceiling source is intentionally reported as partial data.
DATASET_PATH=
DATA_DIR=services/api/.data
DATABASE_PATH=services/api/.data/analytics.duckdb

# Explicitly opt into the synthetic calibrated demo only for tests/local UI work.
# Competition evidence, CI image builds, and production deployment use false.
ALLOW_DEMO_FALLBACK=false
USE_DEMO_DATA=false
