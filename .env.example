# Shared internal boundary. Use one strong value for both services in production.
INTERNAL_API_KEY=local-development-only-change-me
TZ=Asia/Tehran

# Web -> API. API_BASE_URL is for local/deployed absolute URLs. Render injects
# API_HOSTPORT from its private network and the web service adds http:// itself.
API_BASE_URL=http://127.0.0.1:8000
API_HOSTPORT=

# Optional grounded analyst. Keep this server-side; never prefix it NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Official challenge input. DATASET_SHA256 must be set to the verified digest
# before a production build; leaving it blank never authorizes a guessed digest.
DATASET_URL=https://startech.s3.ir-thr-at1.arvanstorage.ir/other%2Fchallenge_data.csv.gz?versionId=
DATASET_SHA256=

# A local .csv, .csv.gz, .xlsx, or cleaned-markdown directory takes precedence.
DATASET_PATH=challenge_data_cleaned.xlsx
DATA_DIR=services/api/.data
DATABASE_PATH=services/api/.data/analytics.duckdb

# Intended only for tests/local UI work when the official host is unavailable.
# Competition evidence and production deployment must use false.
ALLOW_DEMO_FALLBACK=false
USE_DEMO_DATA=false
